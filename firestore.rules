rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['customer', 'farmer'];
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'phone', 'address', 'pickup_location', 'email_verified']);
      allow delete: if isAdmin();
    }

    match /farmers/{farmerId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == farmerId
        && hasRole('farmer') && request.resource.data.user_id == farmerId;
      allow update: if signedIn() && request.auth.uid == farmerId
        && hasRole('farmer') && request.resource.data.user_id == resource.data.user_id;
      allow delete: if isAdmin();
    }

    match /farmers_market/{marketId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if hasRole('farmer')
        && request.resource.data.farmer_id == request.auth.uid
        && request.resource.data.price_per_unit is number
        && request.resource.data.price_per_unit >= 0
        && request.resource.data.stock_qty is int
        && request.resource.data.stock_qty >= 0;
      allow update: if hasRole('farmer')
        && resource.data.farmer_id == request.auth.uid
        && request.resource.data.farmer_id == resource.data.farmer_id
        && request.resource.data.price_per_unit is number
        && request.resource.data.price_per_unit >= 0
        && request.resource.data.stock_qty is int
        && request.resource.data.stock_qty >= 0;
      allow delete: if (hasRole('farmer') && resource.data.farmer_id == request.auth.uid)
        || isAdmin();
    }

    match /orders/{orderId} {
      // Orders are created by the trusted placeOrder Cloud Function only.
      allow create: if false;
      allow read: if signedIn()
        && (resource.data.customer_id == request.auth.uid
          || resource.data.farmer_id == request.auth.uid || isAdmin());
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'pickup_slot_time'])
        && request.resource.data.customer_id == resource.data.customer_id
        && request.resource.data.farmer_id == resource.data.farmer_id
        && ((resource.data.farmer_id == request.auth.uid
              && hasRole('farmer')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status in ['Confirmed', 'Ready for Pickup', 'Completed', 'Cancelled'])
          || (resource.data.customer_id == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pickup_slot_time'])
              && resource.data.status == 'Pending')
          || isAdmin());
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if hasRole('farmer')
        && request.resource.data.farmer_id == request.auth.uid;
      allow read, delete: if hasRole('farmer')
        && resource.data.farmer_id == request.auth.uid;
      allow update: if hasRole('farmer')
        && resource.data.farmer_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
    }

    match /wishlists/{userId}/items/{productId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /follows/{userId}/farmers/{farmerId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
