    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['customer', 'farmer'];

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // A user may edit profile details, but role and account creation time are immutable.
      allow update: if signedIn()
